const Database = require('better-sqlite3');
const path = require('path');
const { app } = require('electron');

// Path to the SQLite database file
const dbPath = path.join(app.getPath('userData'), 'notes.db');
const db = new Database(dbPath);

// 初始化表格
db.exec(`
  CREATE TABLE IF NOT EXISTS notes (
    id TEXT PRIMARY KEY,
    title TEXT,
    content TEXT,
    syncStatus TEXT DEFAULT 'local',
    createdAt TEXT,
    hasMedia INTEGER DEFAULT 0,
    mediaPath TEXT DEFAULT NULL
  );
  CREATE TABLE IF NOT EXISTS conversations (
    id TEXT PRIMARY KEY,
    note_id TEXT,
    role TEXT,
    content TEXT,
    timestamp TEXT,
    FOREIGN KEY (note_id) REFERENCES notes(id) ON DELETE CASCADE
  );
`);

//在notes表中添加新筆記
function createNote(note) {
const insert = db.prepare(`
    INSERT INTO notes (id, title, content, syncStatus, createdAt, hasMedia, mediaPath) 
    VALUES (@id, @title, @content, @syncStatus, @createdAt, @hasMedia, @mediaPath)
  `);
  return insert.run(note);
}

//根據關鍵字搜尋筆記
function searchNotesByKeyword(keyword) {
  const sql = `
    SELECT DISTINCT n.* FROM notes n
    LEFT JOIN conversations c ON n.id = c.note_id
    WHERE n.title LIKE ? 
       OR n.content LIKE ? 
       OR c.content LIKE ?
    ORDER BY n.createdAt DESC
  `;
  const pattern = `%${keyword}%`;
  return db.prepare(sql).all(pattern, pattern, pattern);
}

//返回所有筆記
function listNotes() {
  return db.prepare("SELECT * FROM notes ORDER BY createdAt DESC").all();
}

//在notes表中添加新對話
function addConversation(conv) {
  const insert = db.prepare(`
    INSERT INTO conversations (id, note_id, role, content, timestamp)
    VALUES (@id, @note_id, @role, @content, @timestamp)
  `);
  return insert.run(conv);
}

//根據note_id取得note及其對話
function getNoteWithConversations(noteId) {
  const note = db.prepare("SELECT * FROM notes WHERE id = ?").get(noteId);
  const conversations = db.prepare("SELECT * FROM conversations WHERE note_id = ? ORDER BY timestamp ASC").all(noteId);
  
  return {
    id: note.id,
    title: note.title,
    content: note.content,
    syncStatus: note.syncStatus,
    createdAt: note.createdAt,
    hasMedia: note.hasMedia,
    mediaPath: note.mediaPath,
    conversations: conversations
  };
}

module.exports = { createNote, searchNotesByKeyword, listNotes, addConversation, getNoteWithConversations };